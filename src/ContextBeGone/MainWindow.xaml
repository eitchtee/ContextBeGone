<Window x:Class="ContextBeGone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ContextBeGone"
        Title="ContextBeGone — Windows classic context menu editor"
        Height="840" Width="1520" MinHeight="560" MinWidth="1080"
        Background="{StaticResource Bg}"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI" FontSize="12.5">

    <Window.Resources>
        <local:StatusBrushConverter x:Key="StatusBrush" />
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <local:NotNullConverter x:Key="NotNull" />
        <local:EmptyToVisibleConverter x:Key="EmptyToVisible" />

        <!-- Grey hint text drawn behind an empty TextBox. -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6E6E7A" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ══════════════════════════════════════ toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="RefreshButton" Click="OnRefresh" Content="⟳  Rescan" />
                    <Button x:Name="RestartExplorerButton" Click="OnRestartExplorer" Content="↻  Restart Explorer"
                            ToolTip="Explorer caches context menus. Most changes only appear after this." />
                    <Separator Width="1" Margin="6,2" Background="{StaticResource Border}" />

                    <TextBlock Text="Write to:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource FgMuted}" />
                    <ComboBox x:Name="WriteModeBox" Width="230" VerticalAlignment="Center" Margin="0,0,10,0"
                              SelectionChanged="OnWriteModeChanged">
                        <ComboBoxItem Content="Per-user overlay (HKCU, safe)" IsSelected="True"
                                      ToolTip="Writes into HKCU\Software\Classes\&lt;same path&gt;. HKEY_CLASSES_ROOT merges HKCU over HKLM, so this overrides system entries without touching them and needs no admin rights." />
                        <ComboBoxItem Content="In place (original key)"
                                      ToolTip="Writes to the key the entry was found in. Needed to remove values Windows itself placed in HKLM; usually requires administrator rights and sometimes key ownership." />
                    </ComboBox>

                    <Button Content="&#128269;  Inspect a real item" Click="OnInspect"
                            ToolTip="Ask the shell what a real file or folder's menu actually contains, and trace each item to whatever produces it." />

                    <CheckBox x:Name="ClassicMenuBox" Content="Classic menu by default (Win 11)" Margin="0,0,12,0"
                              Click="OnToggleClassicMenu"
                              ToolTip="Suppresses the Windows 11 compact menu so right-click opens the full classic menu without &quot;Show more options&quot;." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="ElevationText" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                    <Button x:Name="ElevateButton" Click="OnElevate" Content="🛡  Restart as administrator" />
                    <Button x:Name="BackupsButton" Click="OnOpenBackups" Content="📁  Backups" Margin="0" />
                </StackPanel>

                <TextBlock />
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════ pending-restart banner -->
        <Border x:Name="RestartBanner" DockPanel.Dock="Top" Background="#FF3D3115"
                BorderBrush="{StaticResource Warn}" BorderThickness="0,0,0,1"
                Padding="12,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart Explorer now" Click="OnRestartExplorer"
                        Margin="10,0,0,0" Background="#FF5A4A1E" BorderBrush="{StaticResource Warn}" />
                <TextBlock x:Name="RestartBannerText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource Warn}" />
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════ status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock x:Name="StatusText" Text="Ready." Style="{StaticResource Muted}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="360" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ────────────────────────── scenes -->
            <DockPanel Grid.Column="0" Background="{StaticResource Bg}">
                <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="AddTypeButton" DockPanel.Dock="Right" Content="＋" Click="OnAddFileType"
                                Width="26" Height="22" Padding="0" Margin="6,0,0,0" FontSize="14"
                                VerticalContentAlignment="Center"
                                ToolTip="Add a file type, to also list the scopes that apply only to it. Does not change anything on your system." />
                        <TextBlock Text="WHERE THE MENU APPEARS" Style="{StaticResource SectionHeader}"
                                   Margin="0" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid>
                        <TextBox x:Name="SceneSearchBox" TextChanged="OnSceneSearchChanged"
                                 ToolTip="Filters the list below by name, description and registry path." />
                        <TextBlock Text="Search these scopes…" Style="{StaticResource Placeholder}"
                                   Visibility="{Binding Text, ElementName=SceneSearchBox, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                    <TextBlock x:Name="SceneCountText" Style="{StaticResource Muted}" Margin="0,5,0,0" />
                </StackPanel>

                <ListBox x:Name="SceneList" Margin="6,0,6,10" SelectionChanged="OnSceneChanged"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RemoveTypeItem" Header="Remove this file type"
                                      Click="OnRemoveFileType" />
                            <MenuItem Header="Add a file type…" Click="OnAddFileType" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}"
                                               Margin="6,10,0,3" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                           MaxWidth="240" HorizontalAlignment="Left" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}" />

            <!-- ────────────────────────── entries -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="FilterBox" TextChanged="OnFilterChanged"
                                 ToolTip="Filter by name, key, command or CLSID." />
                        <TextBlock x:Name="FilterHint" Text="Filter by name, key, command, CLSID or DLL…" Style="{StaticResource Placeholder}"
                                   Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                    <CheckBox x:Name="HideDisabledBox" Grid.Column="1" Content="Only enabled" Margin="10,0,0,0"
                              Click="OnFilterChanged" />
                    <Button x:Name="NewEntryButton" Grid.Column="2" Content="＋ New entry" Margin="10,0,0,0"
                            Click="OnCreateEntry" />
                </Grid>

                <ListView x:Name="EntryList" Margin="10,0,10,10"
                          Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                          Foreground="{StaticResource Fg}"
                          SelectionChanged="OnEntrySelected"
                          SelectionMode="Extended"
                          PreviewKeyDown="OnEntryListKeyDown"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Enable selected" Click="OnEnableSelected" />
                            <MenuItem Header="Disable selected" Click="OnDisableSelected" />
                            <Separator />
                            <MenuItem Header="Open in regedit" Click="OnOpenRegedit" />
                            <MenuItem Header="Copy registry path" Click="OnCopyPath" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="46">
                                <GridViewColumn.Header>
                                    <TextBlock Text="On"
                                               ToolTip="Untick to hide the entry. Select several rows and press Space to toggle them all." />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Click="OnToggleEntry" HorizontalAlignment="Center"
                                                  Focusable="False" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Entry" Width="290">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,7,0"
                                                   SnapsToDevicePixels="True" />
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Status" Width="76">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Where it appears" Width="152"
                                            DisplayMemberBinding="{Binding Scene.Name}" />
                            <GridViewColumn Header="Registered as" Width="120"
                                            DisplayMemberBinding="{Binding KindText}" />
                            <GridViewColumn Header="Hive" Width="74"
                                            DisplayMemberBinding="{Binding HiveText}" />
                            <GridViewColumn Header="Runs" Width="360"
                                            DisplayMemberBinding="{Binding Target}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}" />

            <!-- ────────────────────────── details / editor -->
            <Border Grid.Column="4" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                    <StackPanel x:Name="DetailPanel">

                        <TextBlock x:Name="DetailTitle" Text="Select an entry" FontSize="15" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailPath" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   FontFamily="Consolas" />

                        <StackPanel x:Name="NavActions" Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="False">
                            <Button Content="Open in regedit" Click="OnOpenRegedit" />
                            <Button Content="Copy path" Click="OnCopyPath" />
                        </StackPanel>

                        <TextBlock Text="MECHANISM" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="DetailMechanism" Style="{StaticResource Muted}" />

                        <!-- Editable verb properties -->
                        <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                            <TextBlock Text="DISPLAY NAME (MUIVerb)" Style="{StaticResource SectionHeader}" />
                            <TextBox x:Name="EditMuiVerb" />
                            <TextBlock x:Name="EditMuiVerbHint" Style="{StaticResource Muted}" Margin="0,3,0,0" />

                            <TextBlock Text="ICON" Style="{StaticResource SectionHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EditIcon" Grid.Column="0" />
                                <Button Grid.Column="1" Content="…" Margin="6,0,0,0" Click="OnBrowseIcon" />
                            </Grid>
                            <TextBlock Text="Path, optionally followed by ,index — e.g. %SystemRoot%\system32\shell32.dll,-16826"
                                       Style="{StaticResource Muted}" Margin="0,3,0,0" />

                            <TextBlock Text="COMMAND" Style="{StaticResource SectionHeader}" />
                            <TextBox x:Name="EditCommand" AcceptsReturn="False" TextWrapping="Wrap" />
                            <TextBlock Text="%1 = the clicked item, %V = the folder or background path, %* = all selected items."
                                       Style="{StaticResource Muted}" Margin="0,3,0,0" />

                            <TextBlock Text="PLACEMENT AND BEHAVIOUR" Style="{StaticResource SectionHeader}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Position" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="EditPosition" Width="120">
                                    <ComboBoxItem Content="(default)" IsSelected="True" />
                                    <ComboBoxItem Content="Top" />
                                    <ComboBoxItem Content="Bottom" />
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="EditExtended" Margin="0,2"
                                      Content="Show only when SHIFT is held (Extended)" />
                            <CheckBox x:Name="EditSeparatorBefore" Margin="0,2" Content="Separator before" />
                            <CheckBox x:Name="EditSeparatorAfter" Margin="0,2" Content="Separator after" />
                            <CheckBox x:Name="EditNeverDefault" Margin="0,2"
                                      Content="Never become the default (bold) verb" />
                            <CheckBox x:Name="EditNoWorkingDirectory" Margin="0,2"
                                      Content="Do not set a working directory" />
                            <CheckBox x:Name="EditLuaShield" Margin="0,2" Content="Show the UAC shield" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Save changes" Click="OnSaveEdits"
                                        Background="#FF2F4A7A" BorderBrush="{StaticResource Accent}" />
                                <Button Content="Revert" Click="OnRevertEdits" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="HandlerNote" Style="{StaticResource Muted}" Visibility="Collapsed"
                                   Margin="0,10,0,0" />

                        <TextBlock x:Name="DangerHeader" Text="DANGER ZONE" Style="{StaticResource SectionHeader}"
                                   Visibility="Collapsed" />
                        <StackPanel x:Name="DangerActions" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Content="Remove overlay" Click="OnRemoveOverlay"
                                    ToolTip="Deletes anything this app wrote under HKCU for this entry, restoring the shipped behaviour." />
                            <Button Content="Delete entry…" Click="OnDeleteEntry"
                                    Foreground="#FFE06C6C" />
                            <Button Content="Take ownership" Click="OnTakeOwnership" Margin="0"
                                    ToolTip="Claims a TrustedInstaller-owned key for Administrators so it can be modified in place. Requires elevation." />
                        </StackPanel>

                        <TextBlock Text="ALL REGISTRY VALUES ON THIS KEY" Style="{StaticResource SectionHeader}" />
                        <ItemsControl x:Name="ValueList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontFamily="Consolas"
                                                   FontSize="11" Foreground="{StaticResource Accent}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas"
                                                   FontSize="11" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="LAST OPERATION" Style="{StaticResource SectionHeader}" />
                        <TextBox x:Name="OperationLog" IsReadOnly="True" TextWrapping="Wrap" MinHeight="70"
                                 FontFamily="Consolas" FontSize="11" Background="{StaticResource Bg}"
                                 BorderThickness="1" Margin="0,0,0,20"
                                 VerticalScrollBarVisibility="Auto" MaxHeight="220" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
