<Window x:Class="ContextBeGone.Views.InspectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Real context menu"
        Height="700" Width="1040" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="12.5">

    <DockPanel Margin="14">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="PathText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="This is the menu the shell actually builds, asked for through IContextMenu — including items that handlers draw in code and never write to the registry. Each row is traced back to whatever produced it." />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox x:Name="MenuModeBox" Width="240" Margin="0,0,14,0" Visibility="Collapsed"
                          SelectionChanged="OnMenuModeChanged"
                          ToolTip="A folder has two separate menus: one for the folder itself, and one for the empty space inside it. They draw from different registry scopes.">
                    <ComboBoxItem Content="Right-clicking the folder" IsSelected="True" />
                    <ComboBoxItem Content="Right-clicking inside it" />
                </ComboBox>
                <CheckBox x:Name="ShowShiftBox" Content="Include SHIFT+right-click items" IsChecked="True"
                          Click="OnToggleShift"
                          ToolTip="Extended verbs: the shell only draws these when SHIFT is held. The menu is built twice and the difference is what you see marked." />
                <TextBlock x:Name="ShiftCountText" Style="{StaticResource Muted}" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#FFE06C6C" Margin="0,6,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="DisableButton" Content="Disable the handler behind this item"
                    Click="OnDisableHandler" Background="#FF5A2A2A" BorderBrush="#FFE06C6C" Padding="14,6" />
            <Button x:Name="FindButton" Content="Find in main list" Click="OnFindInList" Padding="14,6"
                    ToolTip="Closes this window and searches the main list for the entry behind the selected item, ready to edit." />
            <Button Content="Copy report" Click="OnCopyReport" Padding="14,6" />
            <TextBlock x:Name="ResultText" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="520" />
        </StackPanel>

        <ListView x:Name="ItemList" Margin="0,12,0,0"
                  Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}"
                  Foreground="{StaticResource Fg}" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Menu item" Width="360">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="SHIFT" Width="56">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShiftMark}" Foreground="#FFE0A94B"
                                           HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Produced by" Width="280"
                                    DisplayMemberBinding="{Binding Origin}" />
                    <GridViewColumn Header="CLSID / verb" Width="240"
                                    DisplayMemberBinding="{Binding Handle}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
