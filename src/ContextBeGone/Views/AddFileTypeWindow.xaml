<Window x:Class="ContextBeGone.Views.AddFileTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a file type"
        SizeToContent="Height" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="12.5">

    <StackPanel Margin="18">
        <TextBlock Text="Which file type?" FontSize="14" FontWeight="SemiBold" />

        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Loads the registry scopes that apply to one file type — its ProgID, its SystemFileAssociations entries — so you can see and edit the menu items specific to it." />

        <TextBox x:Name="ExtensionBox" Margin="0,14,0,0" FontSize="14" Padding="8,6" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"
                   Text="e.g. .png — “png” and “photo.png” work too." />

        <Border Margin="0,14,0,0" Background="#FF1F2A1F" BorderBrush="#FF3E5A3E" BorderThickness="1"
                CornerRadius="4" Padding="10,8">
            <TextBlock TextWrapping="Wrap" Foreground="#FF9FD6A6"
                       Text="This does not change anything on your system. It only adds scopes to the list so you can look at them; you can remove the type again at any time by right-clicking it." />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Add" Click="OnAdd" IsDefault="True" Padding="20,6"
                    Background="#FF2F4A7A" BorderBrush="{StaticResource Accent}" />
            <Button Content="Cancel" IsCancel="True" Padding="20,6" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
